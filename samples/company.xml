            <employee id="e1" role="lead">
                <name>Alice Petrova</name>
                <email>alice@globex.example</email>
            </employee>
            <employee id="e2" role="dev">
                <name>Bob Ivanov</name>
                <email>bob@globex.example</email>
            </employee>
            <employee role="dev">
                <name>Carol Stoyanova</name>
                <email>carol@globex.example</email>
            </employee>
        </team>
        <team id="frontend" size="2">
            <employee id="e3" role="lead">
                <name>Dimitar Georgiev</name>
                <email>dimitar@globex.example</email>
            </employee>
            <employee id="e4" role="dev">
                <name>Elena Koleva</name>
